<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background_primary">

    <!-- ── TÍTULO: logo + nombre + tagline ── -->
    <LinearLayout
        android:id="@+id/layoutTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layoutCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.40">

        <ImageView
            android:id="@+id/tvAppIcon"
            android:layout_width="169dp"
            android:layout_height="169dp"
            android:src="@drawable/logo_marsan"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_tagline"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"/>

    </LinearLayout>

    <!-- ── BOTÓN JUGAR ── -->
    <LinearLayout
        android:id="@+id/layoutCenter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTitle"
        app:layout_constraintBottom_toTopOf="@id/layoutBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNewGame"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/menu_new_game"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:layout_marginTop="28dp"/>

    </LinearLayout>

    <!-- ── BOTONES SECUNDARIOS ──
         paddingBottom="0dp" aquí — el padding de seguridad se aplica
         desde código en MainActivity usando ViewCompat.setOnApplyWindowInsetsListener
         para que funcione en todos los modelos incluyendo los que tienen
         barra de navegación por gestos o botones en pantalla -->
    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStats"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/menu_stats"
            android:textSize="14sp"
            android:letterSpacing="0.04"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:layout_marginBottom="10dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPrefs"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/menu_prefs"
            android:textSize="14sp"
            android:letterSpacing="0.04"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
