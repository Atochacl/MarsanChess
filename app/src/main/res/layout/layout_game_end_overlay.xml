<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F2FFFFFF"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp"
    android:gravity="center">

    <!-- Ícono (trofeo, tablas, etc.) -->
    <TextView
        android:id="@+id/tvEndIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="52sp"
        android:layout_marginBottom="8dp"/>

    <!-- Título principal: "¡Ganaste!", "Tablas", etc. -->
    <TextView
        android:id="@+id/tvEndTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:gravity="center"
        android:layout_marginBottom="4dp"/>

    <!-- Subtítulo: en modo 2 jugadores muestra quién ganó con color -->
    <TextView
        android:id="@+id/tvEndSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="#333333"
        android:gravity="center"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"
        android:visibility="gone"/>

    <!-- Razón: "Jaque mate", "Rey ahogado", etc. -->
    <TextView
        android:id="@+id/tvEndReason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#555555"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="24dp"/>

    <!-- Nueva partida -->
    <Button
        android:id="@+id/btnEndPlayAgain"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Nueva partida"
        android:textSize="15sp"
        android:stateListAnimator="@null"
        android:backgroundTint="@null"
        android:layout_marginBottom="10dp"/>

    <!-- Menú principal -->
    <Button
        android:id="@+id/btnEndMainMenu"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Menú principal"
        android:textSize="15sp"
        android:stateListAnimator="@null"
        android:backgroundTint="@null"
        android:layout_marginBottom="8dp"/>

    <!-- Ver tablero -->
    <TextView
        android:id="@+id/tvEndClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ver tablero"
        android:textSize="13sp"
        android:paddingVertical="8dp"
        android:textColor="#888888"/>

</LinearLayout>
