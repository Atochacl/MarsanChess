<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- ===== ZONA CPU (arriba) ===== -->
    <LinearLayout
        android:id="@+id/zoneCpu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Reloj CPU -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardClockCpu"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:cardBackgroundColor="#E8EDF0"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">
                <TextView
                    android:id="@+id/tvCpuName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CPU"
                    android:textColor="#555555"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/tvClockCpu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00.00"
                    android:textColor="#555555"
                    android:textSize="15sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Piezas comidas por CPU (lo que CPU capturó = piezas blancas del jugador) -->
        <LinearLayout
            android:id="@+id/layoutCapturedByCpu"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:gravity="center_vertical"/>
    </LinearLayout>

    <!-- ===== TABLERO ===== -->
    <com.marsan.chess.ui.game.BoardView
        android:id="@+id/boardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/zonePlayer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/zoneCpu"
        app:layout_constraintDimensionRatio="1:1"/>

    <!-- ===== ZONA JUGADOR (abajo) ===== -->
    <LinearLayout
        android:id="@+id/zonePlayer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Piezas comidas por jugador (lo que el jugador capturó = piezas negras de CPU) -->
        <LinearLayout
            android:id="@+id/layoutCapturedByPlayer"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:gravity="center_vertical"/>

        <!-- Reloj jugador -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardClockPlayer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            app:cardBackgroundColor="#E8EDF0"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">
                <TextView
                    android:id="@+id/tvPlayerName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Jugador"
                    android:textColor="#555555"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/tvClockPlayer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00.00"
                    android:textColor="#555555"
                    android:textSize="15sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUndo"
                style="@style/Widget.MarsanChess.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:paddingVertical="10dp"
                android:text="↩ Deshacer"
                android:layout_marginEnd="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResign"
                style="@style/Widget.MarsanChess.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:paddingVertical="10dp"
                android:text="@string/game_resign"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Overlay pensando -->
    <LinearLayout
        android:id="@+id/layoutThinking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#CC111111"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/boardView"
        app:layout_constraintEnd_toEndOf="@id/boardView"
        app:layout_constraintStart_toStartOf="@id/boardView"
        app:layout_constraintTop_toTopOf="@id/boardView">
        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="@color/white"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/game_thinking"
            android:textColor="@color/white"
            android:textSize="14sp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
