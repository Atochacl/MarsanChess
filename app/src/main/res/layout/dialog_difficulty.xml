<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/difficulty_title"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="14dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <TextView android:id="@+id/diff1"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:gravity="center"
            android:text="1" android:textSize="11sp"
            android:background="@drawable/bg_difficulty_chip"
            android:layout_marginEnd="4dp"/>

        <TextView android:id="@+id/diff2"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:gravity="center"
            android:text="2" android:textSize="11sp"
            android:background="@drawable/bg_difficulty_chip"
            android:layout_marginEnd="4dp"/>

        <TextView android:id="@+id/diff3"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:gravity="center"
            android:text="3" android:textSize="11sp"
            android:background="@drawable/bg_difficulty_chip_selected"/>

        <TextView android:id="@+id/diff4"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:gravity="center"
            android:text="4" android:textSize="11sp"
            android:background="@drawable/bg_difficulty_chip"
            android:layout_marginStart="4dp"/>

        <TextView android:id="@+id/diff5"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:gravity="center"
            android:text="5" android:textSize="11sp"
            android:background="@drawable/bg_difficulty_chip"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlay"
        style="@style/Widget.MarsanChess.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:paddingVertical="14dp"
        android:text="@string/name_play_button"/>

</LinearLayout>
