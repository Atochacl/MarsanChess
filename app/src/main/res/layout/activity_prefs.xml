<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        app:title="Preferencias"
        app:titleTextColor="@color/text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOMBRE DE JUGADOR"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:letterSpacing="0.08"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardName"
                style="@style/Widget.MarsanChess.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">
                    <TextView
                        android:id="@+id/tvCurrentName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textColor="@color/text_primary"/>
                    <TextView
                        android:id="@+id/tvNameSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Color de piezas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COLOR DE TUS PIEZAS"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:letterSpacing="0.08"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Blancas — caballo blanco -->
                <LinearLayout
                    android:id="@+id/btnColorWhite"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_color_option"
                    android:layout_marginEnd="6dp">
                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/piece_w_knight"
                        android:scaleType="fitCenter"
                        android:contentDescription="Caballo blanco"/>
                    <TextView
                        android:id="@+id/tvWhiteLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blancas"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="6dp"/>
                    <TextView
                        android:id="@+id/tvWhiteTick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="13sp"
                        android:textColor="@color/accent"
                        android:layout_marginTop="3dp"
                        android:visibility="invisible"/>
                </LinearLayout>

                <!-- Negras — caballo negro -->
                <LinearLayout
                    android:id="@+id/btnColorBlack"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_color_option"
                    android:layout_marginEnd="6dp">
                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/piece_b_knight"
                        android:scaleType="fitCenter"
                        android:contentDescription="Caballo negro"/>
                    <TextView
                        android:id="@+id/tvBlackLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Negras"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="6dp"/>
                    <TextView
                        android:id="@+id/tvBlackTick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="13sp"
                        android:textColor="@color/accent"
                        android:layout_marginTop="3dp"
                        android:visibility="invisible"/>
                </LinearLayout>

                <!-- Aleatorio -->
                <LinearLayout
                    android:id="@+id/btnColorRandom"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_color_option">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎲"
                        android:textSize="36sp"/>
                    <TextView
                        android:id="@+id/tvRandomLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aleatorio"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="6dp"/>
                    <TextView
                        android:id="@+id/tvRandomTick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="13sp"
                        android:textColor="@color/accent"
                        android:layout_marginTop="3dp"
                        android:visibility="invisible"/>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvColorDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginTop="@dimen/spacing_md"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
