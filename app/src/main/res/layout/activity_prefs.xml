<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPrefs"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        app:title="@string/prefs_title"
        app:titleTextColor="@color/text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- ── NOMBRE ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prefs_name_section"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:letterSpacing="0.08"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardName"
                style="@style/Widget.MarsanChess.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">
                    <TextView
                        android:id="@+id/tvCurrentName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView
                        android:id="@+id/tvNameSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/accent"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── COLOR DE PIEZAS ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prefs_color_section"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:letterSpacing="0.08"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Blancas -->
                <LinearLayout
                    android:id="@+id/btnColorWhite"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_color_option"
                    android:layout_marginEnd="6dp">
                    <!-- Iconos actualizados desde código según pieceStyle -->
                    <LinearLayout
                        android:id="@+id/containerWhiteIcons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"/>
                    <TextView
                        android:id="@+id/tvWhiteLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prefs_color_white"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="10dp"/>
                    <TextView
                        android:id="@+id/tvWhiteTick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="14sp"
                        android:textColor="@color/accent"
                        android:layout_marginTop="3dp"
                        android:visibility="invisible"/>
                </LinearLayout>

                <!-- Negras -->
                <LinearLayout
                    android:id="@+id/btnColorBlack"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_color_option"
                    android:layout_marginEnd="6dp">
                    <LinearLayout
                        android:id="@+id/containerBlackIcons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"/>
                    <TextView
                        android:id="@+id/tvBlackLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prefs_color_black"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="10dp"/>
                    <TextView
                        android:id="@+id/tvBlackTick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="14sp"
                        android:textColor="@color/accent"
                        android:layout_marginTop="3dp"
                        android:visibility="invisible"/>
                </LinearLayout>

                <!-- Aleatorio -->
                <LinearLayout
                    android:id="@+id/btnColorRandom"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_color_option">
                    <LinearLayout
                        android:id="@+id/containerRandomIcons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"/>
                    <TextView
                        android:id="@+id/tvRandomLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prefs_color_random"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="10dp"/>
                    <TextView
                        android:id="@+id/tvRandomTick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="14sp"
                        android:textColor="@color/accent"
                        android:layout_marginTop="3dp"
                        android:visibility="invisible"/>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvColorDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/accent"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginTop="@dimen/spacing_md"/>

            <!-- ── TIPO DE PIEZAS ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prefs_piece_style_section"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:letterSpacing="0.08"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Estilo 1: PNG pixel art -->
                <LinearLayout
                    android:id="@+id/btnStyle1"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_color_option"
                    android:layout_marginEnd="6dp">
                    <!-- Preview piezas tipo 1 -->
                    <LinearLayout
                        android:id="@+id/containerStyle1Icons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"/>
                    <TextView
                        android:id="@+id/tvStyle1Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prefs_piece_style_1"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="8dp"/>
                    <TextView
                        android:id="@+id/tvStyle1Tick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="13sp"
                        android:textColor="@color/accent"
                        android:layout_marginTop="3dp"
                        android:visibility="invisible"/>
                </LinearLayout>

                <!-- Estilo 2: Unicode -->
                <LinearLayout
                    android:id="@+id/btnStyle2"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_color_option"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:id="@+id/tvStyle2Preview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="♞♜"
                        android:textSize="30sp"
                        android:textColor="@color/text_primary"/>
                    <TextView
                        android:id="@+id/tvStyle2Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prefs_piece_style_2"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="8dp"/>
                    <TextView
                        android:id="@+id/tvStyle2Tick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="13sp"
                        android:textColor="@color/accent"
                        android:layout_marginTop="3dp"
                        android:visibility="invisible"/>
                </LinearLayout>

                <!-- Estilo 3: PNG personalizado -->
                <LinearLayout
                    android:id="@+id/btnStyle3"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_color_option">
                    <LinearLayout
                        android:id="@+id/containerStyle3Icons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"/>
                    <TextView
                        android:id="@+id/tvStyle3Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prefs_piece_style_3"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="8dp"/>
                    <TextView
                        android:id="@+id/tvStyle3Tick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="13sp"
                        android:textColor="@color/accent"
                        android:layout_marginTop="3dp"
                        android:visibility="invisible"/>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvStyleDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/accent"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginTop="@dimen/spacing_md"/>


            <!-- ── GRABACIÓN DE PARTIDAS ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prefs_recording_section"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:letterSpacing="0.08"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardRecording"
                style="@style/Widget.MarsanChess.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/card_padding">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/prefs_recording_label"
                            android:textSize="18sp"
                            android:textColor="@color/text_primary"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/prefs_recording_desc"
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="3dp"
                            android:lineSpacingMultiplier="1.3"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvRecordingStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prefs_recording_on"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Toca la tarjeta para activar o desactivar la grabación"
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                android:layout_marginTop="6dp"/>

            <!-- ── IDIOMA ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prefs_language_section"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:letterSpacing="0.08"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardLanguage"
                style="@style/Widget.MarsanChess.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/card_padding">
                    <TextView
                        android:id="@+id/tvCurrentLanguage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:textColor="@color/text_primary"
                        android:text="🇨🇱  Español"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="@color/accent"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prefs_language_tap"
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                android:layout_marginTop="6dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
